# AI Gateway — jev + laya, tüm projeler (2026-09-23)
ai.nocturndev.com {
	import secure
	header Strict-Transport-Security "max-age=31536000"
	@auth header X-Gateway-Key 9ad9aee52446e0ec9681ddb985a913e02f1f91dea8668975
	handle /nobet/ekran {
		reverse_proxy 172.18.0.1:8787
	}
	handle /rapor/* {
		reverse_proxy 172.18.0.1:8787
	}
        route /quality/* {
            uri strip_prefix /quality
            reverse_proxy 172.18.0.1:8790
        }

	handle_path /audit/* {
		reverse_proxy 172.18.0.1:8788
	}
	handle_path /seo/* {
		reverse_proxy 172.18.0.1:4185
	}
	handle @auth {
		handle_path /laya/* {
			reverse_proxy 172.18.0.1:8100
		}
		handle /nobet/* {
			reverse_proxy 172.18.0.1:8787
		}
		handle /sir/* {
			reverse_proxy 172.18.0.1:8787
		}
		handle /maske* {
			reverse_proxy 172.18.0.1:8787
		}
		handle /kota/* {
			reverse_proxy 172.18.0.1:8787
		}
		handle_path /jev/* {
			reverse_proxy https://api.typesafe.ai {
				header_up Host api.typesafe.ai
				header_up Authorization "Bearer apikey_224aa7a401b5e604c9cb2cadcf725bdc16f_50f9f8eeec94c94a9a1f3665036303f6cb7945adf979c91a57c379ccdfd5e7f7"
			}
		}
	}
	respond 401
}

