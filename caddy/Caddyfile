(secure) {
	header {
		Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
	}
}

api.legafetch.com {
	import secure
	log {
		output file /var/log/caddy/erisim.log {
			roll_size 20mb
			roll_keep 5
		}
		format json
	}
	header {
		# HSTS: tarayici bu alan adina bir yil boyunca yalnizca HTTPS ile gitsin.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	encode zstd gzip
	reverse_proxy gateway:3001 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}

